---
/** Listado de proyectos en tarjetas, con filtro por categoría: /proyectos/ y /en/projects/ */
import Site from '../layouts/Site.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import { getLang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getProjects, toKey } from '../lib/projects';

const lang = getLang(Astro);
const t = useTranslations(lang);
const p = t.projectsPage;
const projects = await getProjects(lang);
const categories = [...new Set(projects.map((item) => item.data.category))];
const [before, accent, after] = p.heading;
---

<Site title={p.title} description={p.description}>
  <PageIntro label={p.label} title={before} accent={accent} after={after} center>
    {p.intro}
    <Fragment slot="after">
      <div data-filter-group class="mt-12 flex flex-wrap justify-center gap-2" role="group" aria-label={p.filter}>
        <button type="button" class="filter" data-filter="all" aria-pressed="true">{p.all} <span class="count">{projects.length}</span></button>
        {
          categories.map((c) => (
            <button type="button" class="filter" data-filter={toKey(c)} aria-pressed="false">
              {c} <span class="count">{projects.filter((item) => item.data.category === c).length}</span>
            </button>
          ))
        }
      </div>
    </Fragment>
  </PageIntro>

  <section class="panel theme-light shell py-8 lg:py-12 mb-[var(--inset)]" aria-label={p.list}>
    <ul class="grid md:grid-cols-2 xl:grid-cols-3 gap-3">
      {
        projects.map((item, i) => (
          <li class="item" data-filter-item={toKey(item.data.category)} data-reveal>
            <ProjectCard project={item} heading="h2" eager={i < 3} sizes="(min-width: 1280px) 30vw, (min-width: 768px) 46vw, 100vw" />
          </li>
        ))
      }
    </ul>
    <p data-filter-empty hidden class="py-16 text-center text-muted text-lg">{p.empty}</p>
  </section>

  <Contact />
</Site>

<style>
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.7em 0.8em 0.7em 1.15em;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.1;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .count {
    display: inline-grid;
    place-items: center;
    min-width: 1.6em;
    height: 1.6em;
    padding-inline: 0.35em;
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.78em;
    font-weight: 700;
  }
  .filter[aria-pressed='true'] {
    background: var(--color-accent);
    color: #000;
    box-shadow: none;
  }
  .filter[aria-pressed='true'] .count {
    background: rgb(0 0 0 / 0.12);
  }
  @media (hover: hover) {
    .filter[aria-pressed='false']:hover {
      box-shadow: inset 0 0 0 1px var(--fg);
    }
  }
  .item[hidden] {
    display: none;
  }
</style>
