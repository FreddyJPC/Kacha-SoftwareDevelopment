---
/** Nosotros: /nosotros/ y /en/about/. Historia, valores, equipo y stack. Contenido en src/data/about.ts y src/data/stack.ts */
import { Image } from 'astro:assets';
import Site from '../layouts/Site.astro';
import PageIntro from '../components/PageIntro.astro';
import Arrow from '../components/Arrow.astro';
import SectionHead from '../components/SectionHead.astro';
import Stats from '../components/Stats.astro';
import TechMarquee from '../components/TechMarquee.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import brandK from '../assets/brand/kacha-k.png';
import portrait from '../assets/team/freddy.jpg';
import { about } from '../data/about';
import { stack } from '../data/stack';
import { site } from '../data/site';
import { getLang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { twoDigits } from '../lib/projects';

const lang = getLang(Astro);
const t = useTranslations(lang);
const p = t.aboutPage;
const { disciplines, founder, story, values } = about[lang];
const [h1Before, h1Accent, h1After] = p.heading;
---

<Site title={p.title} description={p.description}>
  <PageIntro label={p.label} title={h1Before} accent={h1Accent} after={h1After} size="lg" center>
    {p.intro}
  </PageIntro>

  <!-- Historia -->
  <section class="panel theme-light shell py-20 lg:py-28">
    <div class="grid grid-cols-12 gap-x-6 gap-y-12 items-center">
      <figure class="col-span-12 sm:col-span-8 lg:col-span-5">
        <div class="k-card relative overflow-hidden rounded-[calc(var(--radius-panel)*0.8)] aspect-square grid place-items-center">
          <div class="dots-dark dots absolute inset-0"></div>
          <Image src={brandK} alt={p.brandAlt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 40vw, 90vw" class="relative w-[78%] h-auto" data-parallax="4" />
        </div>
        <figcaption class="mt-3 flex justify-between w-full text-sm text-muted">
          <span>{site.fullName}</span>
          <span>{site.location}</span>
        </figcaption>
      </figure>
      <div class="col-span-12 lg:col-span-6 lg:col-start-7">
        <h2 class="label label-star text-muted mb-8" data-reveal>{p.story}</h2>
        <div class="text-lg lg:text-xl leading-relaxed text-muted space-y-5" data-reveal-group>
          {story.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>

    <div class="mt-16 lg:mt-24">
      <Stats />
    </div>
  </section>

  <!-- Valores -->
  <section class="theme-dark bg-bg text-fg shell py-24 lg:py-32" aria-labelledby="values-title">
    <SectionHead label={p.valuesLabel} title={p.valuesTitle} id="values-title" />
    <div class="mt-14 lg:mt-20 grid md:grid-cols-2 gap-2" data-reveal-group>
      {
        values.map((v, i) => (
          <article class="value rounded-[calc(var(--radius-panel)*0.8)] bg-surface p-7 lg:p-9 flex flex-col gap-10 min-h-60">
            <span class="num">{twoDigits(i + 1)}</span>
            <div class="mt-auto">
              <h3 class="text-[clamp(1.4rem,2.2vw,1.9rem)] font-bold tracking-[-0.03em] leading-[1.1]">{v.title}</h3>
              <p class="mt-3 text-lg text-muted leading-relaxed">{v.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <TechMarquee />

  <!-- Equipo + stack -->
  <section class="panel theme-light shell py-20 lg:py-28 space-y-24 lg:space-y-32">
    <div>
      <SectionHead label={p.teamLabel} title={p.teamTitle} size="md" />

      <div class="mt-12 lg:mt-16 grid grid-cols-12 gap-2">
        <article class="founder col-span-12 lg:col-span-5 theme-dark bg-bg text-fg rounded-[calc(var(--radius-panel)*0.8)] overflow-hidden flex flex-col" data-reveal>
          <div class="portrait relative aspect-[4/3] overflow-hidden">
            <Image src={portrait} alt={`${p.portraitAlt} ${founder.name}`} widths={[480, 800, 1200]} quality={70} sizes="(min-width: 1024px) 40vw, 100vw" class="w-full h-full object-cover object-[58%_30%]" />
            <span class="absolute left-4 top-4 tag !border-transparent bg-accent text-black font-bold">{founder.role}</span>
          </div>
          <div class="p-7 lg:p-9 flex flex-col gap-4">
            <h3 class="text-3xl font-bold tracking-[-0.04em] leading-none">{founder.name}</h3>
            <p class="text-muted leading-relaxed">{founder.bio}</p>
            <a href={founder.link} target="_blank" rel="noopener noreferrer" class="group mt-2 inline-flex items-center gap-2 font-medium w-fit">
              <span class="link">LinkedIn</span>
              <Arrow class="w-3.5 h-3.5 text-accent transition-transform duration-500 group-hover:rotate-45" />
            </a>
          </div>
        </article>
        <div class="col-span-12 lg:col-span-7 grid sm:grid-cols-2 auto-rows-fr gap-2" data-reveal-group>
          {
            disciplines.map((d, i) => (
              <article class="rounded-[calc(var(--radius-panel)*0.7)] bg-surface p-6 lg:p-7 flex flex-col justify-between gap-8 min-h-36">
                <span class="num !bg-bg">{twoDigits(i + 1)}</span>
                <div>
                  <h3 class="text-xl font-bold tracking-[-0.03em]">{d.title}</h3>
                  <p class="mt-1.5 text-muted leading-snug">{d.text}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>

    <div>
      <SectionHead label={p.stackLabel} title={p.stackTitle} size="md" />
      <div class="mt-12 lg:mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-2" data-reveal-group>
        {
          stack[lang].map((g) => (
            <div class="rounded-[calc(var(--radius-panel)*0.7)] bg-surface p-6 lg:p-7 min-h-48 flex flex-col">
              <h3 class="flex items-center gap-2.5 text-xl font-bold tracking-tight">
                <span class="w-2 h-2 rounded-full bg-accent"></span>
                {g.group}
              </h3>
              <ul class="mt-7 flex flex-wrap gap-1.5">
                {g.items.map((item) => <li class="tag bg-bg !border-transparent">{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Process />
  <Contact />
</Site>

<style>
  .k-card {
    background:
      radial-gradient(70% 70% at 80% 100%, rgb(0 229 153 / 0.35), transparent 70%),
      radial-gradient(60% 60% at 0% 0%, rgb(0 100 255 / 0.12), transparent 70%), #e3ebe7;
  }
  .value {
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .portrait :global(img) {
    filter: grayscale(1) contrast(1.05);
    transition:
      filter 0.9s var(--ease-out-expo),
      transform 1.1s var(--ease-out-expo);
  }
  @media (hover: hover) {
    .founder:hover .portrait :global(img) {
      filter: grayscale(0);
      transform: scale(1.04);
    }
  }
</style>
