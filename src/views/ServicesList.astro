---
/** Listado de servicios: /servicios/ y /en/services/ */
import Site from '../layouts/Site.astro';
import PageIntro from '../components/PageIntro.astro';
import Arrow from '../components/Arrow.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import { services } from '../data/services';
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { twoDigits } from '../lib/projects';

const lang = getLang(Astro);
const t = useTranslations(lang);
const list = services[lang];
---

<Site title={t.services.title} description={t.servicesPage.description}>
  <PageIntro label={t.services.label} title={t.services.title} count={list.length}>
    {t.servicesPage.intro}
  </PageIntro>

  <section class="panel theme-light shell py-6 lg:py-10 mb-[var(--inset)]" aria-label={t.servicesPage.list}>
    <ul>
      {
        list.map((s, i) => (
          <li class="border-b border-line last:border-0" data-reveal>
            <a href={localePath(lang, 'services', s.slug)} class="row group grid grid-cols-12 gap-x-6 gap-y-4 items-start py-9 lg:py-12" data-cursor={t.common.view}>
              <span class="col-span-12 lg:col-span-1 label text-muted lg:pt-3">({twoDigits(i + 1)})</span>
              <div class="col-span-12 lg:col-span-6">
                <h2 class="row-title text-[clamp(1.7rem,3.8vw,3.4rem)] font-bold tracking-[-0.04em] leading-[1.02]">{s.title}</h2>
                <p class="mt-3 text-lg text-muted max-w-xl leading-snug">{s.summary}</p>
              </div>
              <ul class="col-span-12 sm:col-span-8 lg:col-span-3 flex flex-wrap content-start gap-1.5 lg:pt-2">
                {s.tags.map((tag) => <li class="tag">{tag}</li>)}
              </ul>
              <div class="col-span-12 sm:col-span-4 lg:col-span-2 flex sm:flex-col items-center sm:items-end justify-between gap-4 lg:pt-1">
                <p class="sm:text-right">
                  <span class="block text-xl font-bold tracking-[-0.03em]">{s.from}</span>
                  <span class="label text-muted mt-2">{s.timeline}</span>
                </p>
                <span class="row-arrow shrink-0 grid place-items-center w-11 h-11 rounded-full border border-line"><Arrow /></span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Process />
  <Contact />
</Site>

<style>
  .row-title,
  .row-arrow {
    transition:
      transform 0.7s var(--ease-out-expo),
      background-color 0.4s,
      color 0.4s,
      border-color 0.4s;
  }
  @media (hover: hover) {
    .row:hover .row-title {
      transform: translateX(0.3em);
    }
    .row:hover .row-arrow {
      background: var(--color-accent);
      border-color: var(--color-accent);
      transform: rotate(45deg);
    }
  }
</style>
