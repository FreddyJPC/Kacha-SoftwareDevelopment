---
/** Listado de servicios: /servicios/ y /en/services/ */
import Site from '../layouts/Site.astro';
import PageIntro from '../components/PageIntro.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import { services } from '../data/services';
import { getLang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const lang = getLang(Astro);
const t = useTranslations(lang);
const [before, accent, after] = t.servicesPage.heading;
---

<Site title={t.services.title} description={t.servicesPage.description}>
  <PageIntro label={t.services.label} title={before} accent={accent} after={after} center>
    {t.servicesPage.intro}
  </PageIntro>

  <section class="theme-dark bg-bg text-fg shell pb-20 lg:pb-28" aria-label={t.servicesPage.list}>
    <div class="grid md:grid-cols-2 gap-2" data-reveal-group>
      {services[lang].map((s, i) => <ServiceCard service={s} featured={i === 0} detailed class="min-h-[24rem]" />)}
    </div>
  </section>

  <Process />
  <Contact />
</Site>
