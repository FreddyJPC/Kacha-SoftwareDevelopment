---
/**
 * Detalle de un servicio: /servicios/<slug>/ y /en/services/<slug>/
 * Todo el contenido sale de src/data/services.ts; los proyectos relacionados,
 * de los .md cuyo campo `services` incluye el id del servicio.
 */
import Site from '../layouts/Site.astro';
import PageIntro from '../components/PageIntro.astro';
import Button from '../components/Button.astro';
import CheckList from '../components/CheckList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Timeline from '../components/Timeline.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import type { Service } from '../data/services';
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getProjectsByService, twoDigits } from '../lib/projects';

interface Props {
  service: Service;
  next: Service;
}
const { service: s, next } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
const related = (await getProjectsByService(lang, s.id)).slice(0, 2);
const meta = [
  { k: t.service.investment, v: s.from },
  { k: t.service.timeline, v: s.timeline },
  { k: t.service.tech, v: s.tags.slice(0, 3).join(' · ') },
];
---

<Site title={s.title} description={s.summary}>
  <PageIntro label={t.service.label} title={s.title} size="lg" crumbs={[{ label: t.nav.services, href: localePath(lang, 'services') }]}>
    {s.summary}
    <Fragment slot="after">
      <div class="mt-12 lg:mt-16 grid xl:grid-cols-4 gap-2">
        <dl class="xl:col-span-3 grid grid-cols-2 md:grid-cols-3 gap-2" data-reveal-group data-delay="0.35">
          {
            meta.map((m) => (
              <div class="rounded-2xl bg-surface p-5 shadow-[inset_0_0_0_1px_var(--line)]">
                <dt class="label text-muted mb-3">{m.k}</dt>
                <dd class="text-lg font-medium leading-snug">{m.v}</dd>
              </div>
            ))
          }
        </dl>
        <div class="flex xl:justify-end items-center pt-2 xl:pt-0" data-reveal data-delay="0.45">
          <Button href={`${localePath(lang, 'contact')}?service=${s.id}`} variant="accent">{t.service.quote}</Button>
        </div>
      </div>
    </Fragment>
  </PageIntro>

  <!-- Descripción + qué incluye -->
  <section class="panel theme-light shell py-20 lg:py-28">
    <div class="grid grid-cols-12 gap-x-6 gap-y-8 items-start">
      <div class="col-span-12 lg:col-span-3">
        <span class="grid place-items-center w-16 h-16 rounded-2xl bg-accent text-black" data-reveal>
          <ServiceIcon id={s.id} class="w-8 h-8" />
        </span>
      </div>
      <div class="col-span-12 lg:col-span-9">
        <h2 class="label label-star text-muted mb-6" data-reveal>{t.service.about}</h2>
        <p class="lead" data-reveal>{s.description}</p>
      </div>
    </div>

    <div class="mt-20 lg:mt-28">
      <SectionHead label={t.service.included} title={t.service.includedTitle} size="md" />
    </div>
    <div class="mt-12 lg:mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-2" data-reveal-group>
      {
        s.included.map((item, i) => (
          <article class="rounded-[calc(var(--radius-panel)*0.7)] bg-surface p-7 lg:p-8 flex flex-col gap-10 min-h-56">
            <span class="num !bg-bg">{twoDigits(i + 1)}</span>
            <div class="mt-auto">
              <h3 class="text-xl lg:text-2xl font-bold tracking-[-0.035em] leading-[1.1]">{item.title}</h3>
              <p class="mt-3 text-muted leading-relaxed">{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Cómo lo trabajamos -->
  <section class="theme-dark bg-bg text-fg shell py-24 lg:py-32" aria-labelledby="steps-title">
    <div class="grid grid-cols-12 gap-x-6 gap-y-14">
      <div class="col-span-12 lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <SectionHead label={t.service.process} title={t.service.processTitle} id="steps-title" size="md" align="left">
            {t.service.processIntro}
          </SectionHead>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-8">
        <Timeline items={s.steps} />
      </div>
    </div>
  </section>

  <!-- Para quién + resultados + proyectos -->
  <section class="panel theme-light shell py-20 lg:py-28 space-y-20 lg:space-y-28">
    <div class="grid lg:grid-cols-2 gap-2">
      <CheckList title={t.service.ideal} items={s.ideal} icon="star" />
      <CheckList title={t.service.outcomes} items={s.outcomes} />
    </div>

    {
      related.length > 0 && (
        <div>
          <SectionHead label={t.service.related} title={t.service.relatedTitle} size="md" />
          <div class="mt-12 lg:mt-16 grid md:grid-cols-2 gap-3" data-reveal-group>
            {related.map((project) => <ProjectCard project={project} />)}
          </div>
        </div>
      )
    }
  </section>

  <Faq items={s.faq} title={t.service.faqTitle} intro={t.service.faqIntro(s.title)} id="faq-service" />

  <!-- Siguiente servicio -->
  <div class="theme-dark bg-bg text-fg shell pb-20 lg:pb-28">
    <p class="label label-star text-muted mb-6 mx-auto" data-reveal>{t.service.next}</p>
    <div class="max-w-2xl mx-auto" data-reveal>
      <ServiceCard service={next} class="min-h-[16rem]" />
    </div>
  </div>

  <Contact />
</Site>
