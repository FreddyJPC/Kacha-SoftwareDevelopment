---
/** Portada. Solo compone secciones; el contenido vive en src/data, src/i18n y src/content. */
import Site from '../layouts/Site.astro';
import Hero from '../components/Hero.astro';
import Clients from '../components/Clients.astro';
import Manifesto from '../components/Manifesto.astro';
import Services from '../components/Services.astro';
import TechMarquee from '../components/TechMarquee.astro';
import Work from '../components/Work.astro';
import Process from '../components/Process.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
---

<Site>
  <Hero />
  <Clients />
  <div class="panel theme-light">
    <Manifesto />
  </div>
  <Services />
  <TechMarquee />
  <div class="panel theme-light mt-[var(--inset)]">
    <Work />
  </div>
  <Process />
  <div class="panel theme-light mb-[var(--inset)]">
    <Pricing />
  </div>
  <Testimonials />
  <Faq />
  <Contact />
</Site>
