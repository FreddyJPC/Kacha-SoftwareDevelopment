---
/**
 * Página 404 (una sola para todo el sitio). Se muestra en español o en inglés
 * según el prefijo de la URL que no se encontró.
 */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Star from '../components/Star.astro';
import { locales, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
---

<Base title={useTranslations('es').notFound.title} noindex>
  <main data-intro class="theme-dark bg-bg text-fg shell relative min-h-svh flex flex-col justify-end pt-40 pb-20 overflow-hidden">
    <div class="dots absolute inset-0" aria-hidden="true"></div>
    <Star class="star absolute -right-[10vw] -top-[10vw] w-[60vw] h-[60vw] max-w-[44rem] max-h-[44rem] text-accent/15" />
    {
      locales.map((lang) => {
        const t = useTranslations(lang).notFound;
        return (
          <div class="relative" data-locale={lang} lang={lang} hidden={lang !== 'es'}>
            <p class="label label-star text-muted mb-8">{t.label}</p>
            <h1 class="display display-xl">
              {t.heading[0]}<span class="accent">{t.heading[1]}</span>{t.heading[2]}
            </h1>
            <p class="mt-8 text-xl text-muted max-w-md">{t.text}</p>
            <div class="mt-10 flex flex-wrap gap-3">
              <Button href={localePath(lang)} variant="accent">{t.home}</Button>
              <Button href={localePath(lang, 'projects')} variant="ghost">{t.work}</Button>
            </div>
          </div>
        );
      })
    }
  </main>
  <script is:inline data-astro-rerun>
    (function () {
      var lang = /^\/en(\/|$)/.test(location.pathname) ? 'en' : 'es';
      document.documentElement.lang = lang;
      if (lang === 'en') document.title = 'Page not found — Kacha';
      document.querySelectorAll('[data-locale]').forEach(function (el) {
        el.hidden = el.getAttribute('data-locale') !== lang;
      });
    })();
  </script>
</Base>

<style>
  .star {
    animation: spin-slow 80s linear infinite;
  }
</style>
