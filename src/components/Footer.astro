---
import { services } from '../data/services';
import { site, socials } from '../data/site';
import { anchorPath, getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import Arrow from './Arrow.astro';
import Star from './Star.astro';

const lang = getLang(Astro);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const [line1, before, accent] = t.footer.cta;
const links = [
  { label: t.nav.services, href: localePath(lang, 'services') },
  { label: t.nav.projects, href: localePath(lang, 'projects') },
  { label: t.nav.process, href: anchorPath(lang, t.ids.process) },
  { label: t.nav.pricing, href: localePath(lang, 'pricing') },
  { label: t.nav.about, href: localePath(lang, 'about') },
  { label: t.nav.contact, href: localePath(lang, 'contact') },
];
---

<footer class="theme-dark bg-bg text-fg overflow-hidden">
  <div class="shell pt-20 lg:pt-28 grid grid-cols-12 gap-x-6 gap-y-12">
    <div class="col-span-12 lg:col-span-5">
      <p class="label text-muted mb-5">{t.footer.start}</p>
      <a href={localePath(lang, 'contact')} class="group flex w-fit items-start gap-3 text-[clamp(1.9rem,4.4vw,3.75rem)] font-bold tracking-[-0.045em] leading-[0.98]">
        <span>{line1}<br />{before}<span class="accent font-normal text-accent">{accent}</span></span>
        <Arrow class="w-[0.55em] h-[0.55em] mt-[0.18em] shrink-0 text-accent transition-transform duration-500 group-hover:rotate-45" />
      </a>
      <div class="mt-8 flex flex-col gap-1.5 text-lg">
        <a href={`mailto:${site.email}`} class="w-fit break-all"><span class="link">{site.email}</span></a>
        <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="w-fit"><span class="link">{site.phone}</span></a>
      </div>
    </div>

    <div class="col-span-6 sm:col-span-4 lg:col-span-2 lg:col-start-7">
      <p class="label text-muted mb-5">{t.footer.site}</p>
      <ul class="space-y-1.5 text-lg">
        {links.map((n) => <li><a href={n.href} class="link">{n.label}</a></li>)}
      </ul>
    </div>
    <div class="col-span-6 sm:col-span-4 lg:col-span-2">
      <p class="label text-muted mb-5">{t.footer.services}</p>
      <ul class="space-y-1.5 text-lg">
        {services[lang].map((s) => <li><a href={localePath(lang, 'services', s.slug)} class="link">{s.short}</a></li>)}
      </ul>
    </div>
    <div class="col-span-12 sm:col-span-4 lg:col-span-2">
      <p class="label text-muted mb-5">{t.footer.social}</p>
      <ul class="space-y-1.5 text-lg">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1.5">
                <span class="link">{s.label}</span>
                <Arrow class="w-3 h-3 text-muted transition-transform duration-500 group-hover:rotate-45" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="shell mt-16 lg:mt-24 overflow-hidden">
    <p data-wordmark class="wordmark flex items-center justify-center gap-[0.12em] whitespace-nowrap select-none" aria-hidden="true">
      <Star class="wordmark-star w-[0.78em] h-[0.78em] text-accent shrink-0" />
      <span>KACHA</span>
    </p>
  </div>

  <div class="shell py-6 !pr-[calc(var(--gutter)+4rem)] border-t border-line flex w-full flex-wrap items-center justify-between gap-x-6 gap-y-3 label text-muted">
    <p>© {year} {site.fullName}</p>
    <p class="hidden md:block">{site.location} — <span data-clock={site.timezone}>--:--:--</span></p>
    <a href={localePath(lang, 'privacy')} class="link">{t.footer.privacy}</a>
    <a href="#top" class="inline-flex items-center gap-2 text-fg">{t.footer.top} <Arrow class="w-3 h-3 -rotate-45" /></a>
  </div>
</footer>

<style>
  .wordmark {
    font-family: var(--font-wide);
    font-size: 12.6vw;
    line-height: 1;
    letter-spacing: -0.02em;
    padding-bottom: 0.14em;
  }
  .wordmark :global(.wordmark-star) {
    animation: spin-slow 28s linear infinite;
  }
</style>
