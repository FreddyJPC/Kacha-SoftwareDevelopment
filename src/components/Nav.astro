---
/**
 * Barra de navegación: tarjeta de vidrio centrada (como la del sitio original).
 * En móvil el menú se despliega como una tarjeta bajo la barra.
 */
import { site, socials } from '../data/site';
import { anchorPath, getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import Button from './Button.astro';
import LangSwitch from './LangSwitch.astro';
import Star from './Star.astro';

const lang = getLang(Astro);
const t = useTranslations(lang);
const links = [
  { label: t.nav.services, href: localePath(lang, 'services') },
  { label: t.nav.projects, href: localePath(lang, 'projects') },
  { label: t.nav.process, href: anchorPath(lang, t.ids.process) },
  { label: t.nav.pricing, href: localePath(lang, 'pricing') },
  { label: t.nav.about, href: localePath(lang, 'about') },
];
const contact = localePath(lang, 'contact');
const current = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && href !== localePath(lang) && current.startsWith(href);
---

<header data-nav class="site-nav theme-dark fixed inset-x-0 top-0 z-50 px-[var(--inset)] pt-3">
  <div class="nav-bar mx-auto max-w-[1240px] flex items-center justify-between gap-3 rounded-2xl pl-5 pr-2 h-16 text-fg">
    <a href={localePath(lang)} class="logo flex items-center gap-2.5 font-bold text-[1.1rem] tracking-[0.06em] whitespace-nowrap" title={`${site.name}, ${t.nav.home}`}>
      <Star class="logo-star w-6 h-6 text-accent" />
      <span>KACHA</span>
    </a>

    <nav class="hidden lg:flex items-center gap-1 text-[0.95rem] font-medium" aria-label={t.nav.main}>
      {links.map((item) => <a href={item.href} class="nav-link px-3.5 py-2 rounded-xl" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <LangSwitch class="max-[359px]:hidden" />
      <Button href={contact} variant="accent" class="!text-sm !py-3 hidden sm:inline-flex">{t.common.cta}</Button>
      <button
        type="button"
        data-menu-toggle
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
        class="menu-toggle lg:hidden grid place-items-center w-11 h-11 rounded-xl bg-accent text-black"
        aria-label={t.nav.openMenu}
        aria-expanded="false"
        aria-controls="menu"
      >
        <span class="relative block w-4 h-3">
          <i></i><i></i><i></i>
        </span>
      </button>
    </div>
  </div>
</header>

<div data-menu-close class="menu-backdrop fixed inset-0 z-40 bg-black/60 backdrop-blur-[2px] lg:hidden" aria-hidden="true"></div>
<div id="menu" data-menu class="mobile-menu theme-dark fixed z-40 inset-x-[var(--inset)] top-[calc(0.75rem+4.5rem)] max-h-[calc(100svh-6rem)] overflow-y-auto rounded-2xl bg-surface text-fg p-3 lg:hidden">
  <nav class="flex flex-col" aria-label={t.nav.mobile}>
    {
      [...links, { label: t.nav.contact, href: contact }].map((item, i) => (
        <a href={item.href} class="menu-link group flex items-center justify-between gap-4 px-3 py-3.5 rounded-xl" style={`--i:${i}`}>
          <span class="text-[1.6rem] font-bold tracking-[-0.03em]">{item.label}</span>
          <span class="grid place-items-center w-9 h-9 rounded-full text-accent" aria-hidden="true">
            <svg viewBox="0 0 16 16" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12 12 4M5.5 4H12v6.5"></path></svg>
          </span>
        </a>
      ))
    }
  </nav>
  <div class="mt-3 p-3 pt-5 border-t border-line flex flex-col gap-5">
    <div class="flex flex-wrap items-center gap-3">
      <Button href={contact} variant="accent" class="w-fit">{t.common.cta}</Button>
      <LangSwitch />
    </div>
    <div class="flex flex-wrap gap-x-5 gap-y-2 text-muted">
      {socials.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer" class="link">{s.label}</a>)}
    </div>
  </div>
</div>

<style>
  .site-nav {
    transition: transform 0.6s var(--ease-out-expo);
  }
  .site-nav.is-hidden {
    transform: translateY(-130%);
  }
  .nav-bar {
    background: rgb(13 13 13 / 0.78);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 10px 30px -12px rgb(0 0 0 / 0.5);
  }
  .logo :global(.logo-star) {
    transition: transform 0.9s var(--ease-out-expo);
  }
  .nav-link {
    color: rgb(244 247 245 / 0.78);
    transition:
      color 0.3s ease,
      background-color 0.3s ease;
  }
  .nav-link[aria-current='page'] {
    color: var(--color-accent);
    background: rgb(0 229 153 / 0.1);
  }
  @media (hover: hover) {
    .logo:hover :global(.logo-star) {
      transform: rotate(180deg) scale(1.15);
    }
    .nav-link:hover {
      color: var(--fg);
      background: rgb(255 255 255 / 0.06);
    }
    .menu-link:hover {
      background: rgb(255 255 255 / 0.05);
    }
  }
  .menu-toggle i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease-out-expo),
      opacity 0.3s ease;
  }
  .menu-toggle i:nth-child(1) {
    top: 0;
  }
  .menu-toggle i:nth-child(2) {
    top: calc(50% - 1px);
  }
  .menu-toggle i:nth-child(3) {
    top: calc(100% - 2px);
  }
  :global(.menu-open) .menu-toggle i:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  :global(.menu-open) .menu-toggle i:nth-child(2) {
    opacity: 0;
  }
  :global(.menu-open) .menu-toggle i:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }
  .mobile-menu {
    box-shadow:
      inset 0 0 0 1px var(--line),
      0 30px 60px -20px rgb(0 0 0 / 0.7);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px) scale(0.98);
    transform-origin: top center;
    transition:
      opacity 0.3s ease,
      transform 0.45s var(--ease-out-expo),
      visibility 0s 0.45s;
  }
  .menu-backdrop {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s ease,
      visibility 0s 0.35s;
  }
  :global(.menu-open) .mobile-menu,
  :global(.menu-open) .menu-backdrop {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.3s ease,
      transform 0.45s var(--ease-out-expo),
      visibility 0s;
  }
  .menu-link {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  :global(.menu-open) .menu-link {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s var(--ease-out-expo) calc(0.05s + var(--i) * 0.04s),
      transform 0.5s var(--ease-out-expo) calc(0.05s + var(--i) * 0.04s),
      background-color 0.3s ease;
  }
</style>
