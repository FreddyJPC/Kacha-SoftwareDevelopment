---
/**
 * Formulario de contacto. La lógica de envío (Supabase + WhatsApp) está en src/scripts/modules/form.ts.
 * Los valores que se guardan (servicio, presupuesto) van siempre en español para que el equipo
 * los lea igual sin importar el idioma del visitante; el idioma se añade al lead.
 */
import { services } from '../data/services';
import { site } from '../data/site';
import { getLang } from '../i18n/config';
import { ui, useTranslations } from '../i18n/ui';
import Button from './Button.astro';

const lang = getLang(Astro);
const t = useTranslations(lang).form;
const budgetsEs = ui.es.form.budgets;
---

<form
  data-lead-form
  data-status="idle"
  data-lang={lang}
  data-greeting={t.greeting}
  data-plan-text={t.planText}
  class="theme-light bg-bg text-fg rounded-[calc(var(--radius-panel)*0.8)] p-6 sm:p-9 lg:p-10 flex flex-col gap-6"
>
  <h3 class="text-3xl lg:text-[2.5rem] font-bold tracking-[-0.045em] leading-none">{t.title}</h3>

  <!-- Trampa para bots: los humanos no ven este campo -->
  <input type="text" name="empresa_web" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <fieldset class="flex flex-col gap-3">
    <legend class="text-[0.95rem] font-medium mb-3">{t.need}</legend>
    <div class="flex flex-wrap gap-2">
      {
        services[lang].map((s) => (
          <label class="choice">
            <input type="checkbox" name="servicio" value={services.es.find((e) => e.id === s.id)?.short ?? s.short} data-id={s.id} />
            <span>{s.short}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <label class="field">
    <span>{t.idea}</span>
    <textarea name="idea" rows="4" required placeholder={t.ideaPlaceholder}></textarea>
  </label>

  <div class="grid sm:grid-cols-2 gap-5">
    <label class="field">
      <span>{t.name}</span>
      <input type="text" name="nombre" required autocomplete="name" placeholder={t.namePlaceholder} />
    </label>
    <label class="field">
      <span>{t.phone}</span>
      <input type="tel" name="telefono" required autocomplete="tel" placeholder="+593 99 123 4567" />
    </label>
  </div>
  <label class="field">
    <span>{t.email}</span>
    <input type="email" name="email" required autocomplete="email" placeholder={t.emailPlaceholder} />
  </label>

  <fieldset class="flex flex-col gap-3">
    <legend class="text-[0.95rem] font-medium mb-3">{t.budget} <span class="text-muted font-normal">{t.optional}</span></legend>
    <div class="flex flex-wrap gap-2">
      {
        t.budgets.map((b, i) => (
          <label class="choice">
            <input type="radio" name="presupuesto" value={budgetsEs[i]} />
            <span>{b}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="flex flex-wrap items-center gap-x-5 gap-y-3 pt-1">
    <Button type="submit" variant="solid">{t.send}</Button>
    <a href={site.whatsapp} data-form-whatsapp={site.whatsapp} target="_blank" rel="noopener noreferrer" class="font-medium text-muted hover:text-fg transition-colors">
      <span class="link">{t.orWhatsapp}</span>
    </a>
  </div>

  <div aria-live="polite">
    <p data-form-msg="sending" hidden class="msg">{t.sending}</p>
    <p data-form-msg="success" hidden class="msg msg-ok">{t.success}</p>
    <p data-form-msg="error" hidden class="msg msg-err">
      {t.error[0]}<a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">{t.error[1]}</a>{t.error[2]}
    </p>
  </div>
</form>

<style>
  .msg {
    border-radius: 0.9rem;
    padding: 0.9rem 1.1rem;
    background: var(--surface);
    font-weight: 500;
    line-height: 1.4;
  }
  .msg-ok {
    background: #c9f7e2;
    color: #00402b;
  }
  .msg-err {
    background: #ffe1e1;
    color: #7a1414;
  }
</style>
