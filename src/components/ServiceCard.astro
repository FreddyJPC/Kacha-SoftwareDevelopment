---
/**
 * Tarjeta de servicio (bento de la portada y listado de servicios).
 * featured=true la pinta en verde; detailed=true muestra además etiquetas y plazo.
 */
import type { Service } from '../data/services';
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  service: Service;
  featured?: boolean;
  detailed?: boolean;
  class?: string;
}
const { service: s, featured = false, detailed = false, class: cls = '' } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<a
  href={localePath(lang, 'services', s.slug)}
  class:list={['svc group relative flex flex-col justify-between gap-10 rounded-[calc(var(--radius-panel)*0.8)] p-7 lg:p-8 overflow-hidden', featured ? 'theme-accent bg-bg text-fg' : 'is-plain', cls]}
  data-shine
>
  <div class="relative flex items-start justify-between gap-4">
    <span class="svc-icon grid place-items-center w-12 h-12 rounded-2xl">
      <ServiceIcon id={s.id} />
    </span>
    <span class="tag font-medium">{s.from}</span>
  </div>

  <div class="relative">
    <h3 class="text-[clamp(1.45rem,2.1vw,1.9rem)] font-bold tracking-[-0.03em] leading-[1.08]">{s.title}</h3>
    <p class="mt-3 text-muted leading-snug max-w-md">{s.summary}</p>
    {
      detailed && (
        <ul class="mt-6 flex flex-wrap gap-1.5">
          {s.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      )
    }
    <p class="mt-7 flex items-center justify-between gap-4">
      <span class="font-bold">{t.services.view}</span>
      <span class="svc-arrow grid place-items-center w-10 h-10 rounded-full">
        <svg viewBox="0 0 16 16" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"></path></svg>
      </span>
    </p>
    {detailed && <p class="mt-4 label text-muted">{s.timeline}</p>}
  </div>
</a>

<style>
  .svc {
    transition:
      transform 0.6s var(--ease-out-expo),
      box-shadow 0.6s var(--ease-out-expo);
  }
  .svc.is-plain {
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .svc::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 0%), rgb(0 229 153 / 0.14), transparent 65%);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .svc-icon {
    background: var(--color-accent);
    color: #000;
  }
  .theme-accent .svc-icon {
    background: #000;
    color: var(--color-accent);
  }
  .svc-arrow {
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      transform 0.5s var(--ease-out-expo),
      background-color 0.4s,
      color 0.4s;
  }
  @media (hover: hover) {
    .svc:hover {
      transform: translateY(-6px);
    }
    .svc.is-plain:hover {
      box-shadow:
        inset 0 0 0 1px rgb(0 229 153 / 0.45),
        0 24px 50px -24px rgb(0 0 0 / 0.6);
    }
    .svc:hover::before {
      opacity: 1;
    }
    .svc:hover .svc-arrow {
      transform: rotate(45deg);
      background: var(--fg);
      color: var(--bg);
    }
  }
</style>
