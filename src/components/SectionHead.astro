---
/**
 * Cabecera de sección: insignia, título con una palabra destacada en verde y texto de apoyo.
 * Por defecto va centrada; align="left" la alinea a la izquierda.
 * `title` acepta [antes, acento, después] o un texto simple.
 */
interface Props {
  label: string;
  title: string | [string, string, string];
  id?: string;
  size?: 'lg' | 'md';
  align?: 'center' | 'left';
}
const { label, title, id, size = 'lg', align = 'center' } = Astro.props;
const [before, accent, after] = Array.isArray(title) ? title : [title, '', ''];
const center = align === 'center';
---

<header class:list={['flex flex-col gap-6', center ? 'items-center text-center' : 'items-start']}>
  <span class="label label-star text-muted" data-reveal>{label}</span>
  <h2 id={id} class:list={['display max-w-[18ch]', size === 'lg' ? 'display-lg' : 'display-md']} data-split>
    {before}{accent && <span class="accent">{accent}</span>}{after}
  </h2>
  {
    Astro.slots.has('default') && (
      <div class:list={['text-muted text-lg leading-snug max-w-xl']} data-reveal>
        <slot />
      </div>
    )
  }
</header>
