---
/**
 * Cabecera de sección: etiqueta, título enorme con punto verde, contador y texto de apoyo.
 * `accent` es la parte del título que va en serif itálica (opcional).
 */
interface Props {
  label: string;
  title: string;
  accent?: string;
  after?: string;
  count?: number | string;
  id?: string;
  size?: 'lg' | 'md';
}
const { label, title, accent, after, count, id, size = 'lg' } = Astro.props;
const n = typeof count === 'number' ? String(count).padStart(2, '0') : count;
---

<header class="grid grid-cols-12 gap-x-6 gap-y-8 items-end">
  <div class="col-span-12">
    <span class="label label-star text-muted" data-reveal>{label}</span>
  </div>
  <h2 id={id} class:list={['col-span-12 lg:col-span-8 display', size === 'lg' ? 'display-lg' : 'display-md']} data-split>
    {title}{accent && <span class="accent text-[1.06em]">{accent}</span>}{after}<span class="dot">.</span>{n && <sup class="ml-[0.15em] align-top text-[0.16em] font-medium tracking-normal text-muted relative top-[0.6em] font-mono">({n})</sup>}
  </h2>
  <div class="col-span-12 sm:col-span-8 lg:col-span-4 lg:pb-3 text-muted text-lg leading-snug max-w-md lg:justify-self-end" data-reveal>
    <slot />
  </div>
</header>
