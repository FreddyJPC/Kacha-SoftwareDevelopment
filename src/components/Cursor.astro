---
/**
 * Elementos que siguen al puntero:
 *  - una píldora verde con texto y flecha sobre los elementos con data-cursor="texto"
 *  - el foco de luz verde, la firma del sitio original de Kacha
 */
---

<div data-spotlight class="spotlight" aria-hidden="true"></div>
<div data-cursor-el class="cursor fixed top-0 left-0 z-[80] pointer-events-none" aria-hidden="true">
  <div class="cursor-inner">
    <span data-cursor-label></span>
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12 12 4M5.5 4H12v6.5"></path></svg>
  </div>
</div>

<style is:global>
  .cursor-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 18px 0 0 18px;
    padding: 0.6rem 0.9rem 0.6rem 1rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #000;
    font-weight: 700;
    font-size: 0.85rem;
    white-space: nowrap;
    box-shadow: 0 10px 30px -8px rgb(0 0 0 / 0.45);
    transform: scale(0) rotate(-8deg);
    transform-origin: 0 0;
    transition: transform 0.45s var(--ease-out-expo);
  }
  .cursor-inner svg {
    width: 0.8rem;
    height: 0.8rem;
  }
  .cursor.is-active .cursor-inner {
    transform: scale(1) rotate(0);
  }
  .spotlight {
    position: fixed;
    top: -280px;
    left: -280px;
    z-index: 30;
    width: 560px;
    height: 560px;
    border-radius: 999px;
    pointer-events: none;
    mix-blend-mode: screen;
    background: radial-gradient(closest-side, rgb(0 229 153 / 0.2), rgb(0 229 153 / 0.07) 45%, transparent 100%);
    opacity: 0;
    transition: opacity 0.6s ease;
    will-change: transform;
  }
  .spotlight.is-on {
    opacity: 1;
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .cursor,
    .spotlight {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spotlight {
      display: none;
    }
  }
</style>
