---
/**
 * Bloque de contacto: texto y datos a la izquierda, formulario a la derecha. Cierra casi todas las páginas.
 * heading="h1" cuando es el contenido principal (página de contacto).
 */
import { site } from '../data/site';
import { getLang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import Arrow from './Arrow.astro';
import ContactForm from './ContactForm.astro';

interface Props {
  heading?: 'h1' | 'h2';
  id?: string;
}
const lang = getLang(Astro);
const t = useTranslations(lang);
const { heading: H = 'h2', id = t.ids.contact } = Astro.props;
const main = H === 'h1';
const [before, accent, after] = t.contact.lead;
const [hBefore, hAccent, hAfter] = t.contact.heading;
const channels = [
  { label: 'WhatsApp', value: site.phone, href: site.whatsapp, external: true },
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, external: false },
];
---

<section id={id} class:list={['theme-dark p-[var(--inset)]', main && 'pt-[calc(var(--inset)*2+4.5rem)]']} aria-labelledby={`${id}-title`}>
  <div class="contact relative overflow-hidden rounded-[var(--radius-panel)] bg-surface text-fg" data-intro={main ? '' : undefined}>
    <div class="dots absolute inset-0" aria-hidden="true"></div>
    <div class="halo halo-green -bottom-[45%] -left-[20%]" aria-hidden="true"></div>
    <div class="halo halo-blue -top-[40%] -right-[20%]" aria-hidden="true"></div>

    <div class="relative z-10 shell py-12 lg:py-16 grid grid-cols-12 gap-x-6 gap-y-12">
      <!-- Texto -->
      <div class="col-span-12 lg:col-span-6 flex flex-col gap-10 lg:pr-6">
        <div>
          <p class="label label-star text-muted mb-7" data-reveal>{t.contact.title}</p>
          <H id={`${id}-title`} class="display display-lg" data-split>
            {hBefore}<span class="accent">{hAccent}</span>{hAfter}
          </H>
          <p class="mt-6 text-xl lg:text-2xl font-medium tracking-[-0.02em] leading-[1.25] text-fg/85 max-w-xl" data-reveal>
            {before}<span class="text-accent">{accent}</span>{after}
          </p>
        </div>

        <ol class="steps flex flex-col" data-reveal-group>
          {
            t.contact.next.map((step, i) => (
              <li class="flex items-center gap-4 py-3.5">
                <span class="num shrink-0 !bg-bg">{i + 1}</span>
                <span class="leading-snug text-fg/85">{step}</span>
              </li>
            ))
          }
        </ol>

        <div class="grid sm:grid-cols-2 gap-2" data-reveal-group>
          {
            channels.map((c) => (
              <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener noreferrer' : undefined} class="channel group rounded-2xl p-5 flex flex-col gap-2">
                <span class="label text-muted">{c.label}</span>
                <span class="font-medium break-all flex items-start justify-between gap-3">
                  {c.value}
                  <Arrow class="w-4 h-4 mt-1 shrink-0 text-accent transition-transform duration-500 group-hover:rotate-45" />
                </span>
              </a>
            ))
          }
        </div>

        <p class="text-sm text-muted leading-relaxed" data-reveal>
          {t.common.responseTime} · {t.contact.hours}<br />
          {site.location} · {t.common.coverage}.
        </p>
      </div>

      <!-- Formulario -->
      <div class="col-span-12 lg:col-span-6 xl:col-span-5 xl:col-start-8" data-reveal>
        <ContactForm />
      </div>
    </div>
  </div>
</section>

<style>
  .steps li + li {
    border-top: 1px dashed var(--line);
  }
  .channel {
    background: rgb(0 0 0 / 0.35);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      box-shadow 0.4s ease,
      background-color 0.4s ease;
  }
  @media (hover: hover) {
    .channel:hover {
      background: rgb(0 0 0 / 0.55);
      box-shadow: inset 0 0 0 1px rgb(0 229 153 / 0.45);
    }
  }
</style>
