---
/** Sección de precios de la portada: planes + nota + acceso a la página completa. */
import { pricingNote } from '../data/pricing';
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import Button from './Button.astro';
import PlanCards from './PlanCards.astro';
import SectionHead from './SectionHead.astro';

const lang = getLang(Astro);
const t = useTranslations(lang);
const [before, accent, after] = t.pricing.customTitle;
---

<section id={t.ids.pricing} class="shell pt-24 lg:pt-36 pb-20 lg:pb-28" aria-labelledby="pricing-title">
  <SectionHead label={t.pricing.label} title={t.pricing.title} id="pricing-title">
    {t.pricing.intro}
  </SectionHead>

  <div class="mt-14 lg:mt-24">
    <PlanCards />
  </div>

  <div class="custom mt-2 lg:mt-6 rounded-[calc(var(--radius-panel)*0.8)] bg-surface p-7 lg:p-9 flex flex-wrap items-center justify-between gap-x-10 gap-y-6" data-reveal>
    <div class="max-w-2xl">
      <h3 class="text-2xl lg:text-[1.9rem] font-bold tracking-[-0.035em] leading-[1.05]">{before}<span class="accent font-normal text-[1.08em]">{accent}</span>{after}</h3>
      <p class="mt-2 text-muted text-lg leading-snug">{t.pricing.customText}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <Button href={localePath(lang, 'contact')} variant="solid">{t.pricing.customCta}</Button>
      <Button href={localePath(lang, 'pricing')} variant="ghost">{t.pricing.allPlans}</Button>
    </div>
  </div>

  <p class="mt-6 text-sm text-muted" data-reveal>{pricingNote[lang]}</p>
</section>
