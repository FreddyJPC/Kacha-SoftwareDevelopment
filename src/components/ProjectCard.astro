---
/** Tarjeta de proyecto: la portada dentro de un marco, con cliente, categoría y tecnologías. */
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import type { Project } from '../lib/projects';
import ProjectCover from './ProjectCover.astro';

interface Props {
  project: Project;
  eager?: boolean;
  sizes?: string;
  /** h3 dentro de una sección con h2; h2 cuando cuelga directamente del h1 (listado de proyectos) */
  heading?: 'h2' | 'h3';
}
const { project, eager, sizes, heading: H = 'h3' } = Astro.props;
const { title, summary, stack, year, category, client } = project.data;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<a href={localePath(lang, 'projects', project.slug)} class="card group flex flex-col h-full rounded-[calc(var(--radius-panel)*0.8)] p-2" data-cursor={t.common.view}>
  <div class="card-media relative overflow-hidden rounded-[calc(var(--radius-panel)*0.6)] bg-surface aspect-[4/3]">
    <ProjectCover project={project} eager={eager} sizes={sizes} />
    <span class="card-go absolute right-4 bottom-4 grid place-items-center w-12 h-12 rounded-full bg-accent text-black" aria-hidden="true">
      <svg viewBox="0 0 16 16" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12 12 4M5.5 4H12v6.5"></path></svg>
    </span>
  </div>
  <div class="flex flex-col flex-1 px-4 pt-5 pb-4 lg:px-5">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="tag !border-transparent bg-accent text-black font-bold">{category}</span>
      <span class="text-sm text-muted">{client} · {year}</span>
    </div>
    <H class="mt-4 text-2xl lg:text-[1.75rem] font-bold tracking-[-0.03em] leading-[1.1]">{title}</H>
    <p class="mt-2 text-muted leading-snug">{summary}</p>
    <ul class="mt-auto pt-5 flex flex-wrap gap-1.5">
      {stack.slice(0, 4).map((s) => <li class="tag text-muted">{s}</li>)}
    </ul>
  </div>
</a>

<style>
  .card {
    background: var(--surface);
    transition:
      transform 0.6s var(--ease-out-expo),
      box-shadow 0.6s var(--ease-out-expo);
  }
  .card-media :global(.cover-media) {
    transition: transform 1.1s var(--ease-out-expo);
  }
  .card-go {
    transform: scale(0) rotate(-45deg);
    transition: transform 0.55s var(--ease-out-expo);
  }
  @media (hover: hover) {
    .card:hover {
      transform: translateY(-6px);
      box-shadow: 0 30px 60px -32px rgb(0 0 0 / 0.45);
    }
    .card:hover .card-media :global(.cover-media) {
      transform: scale(1.04);
    }
    .card:hover .card-go {
      transform: scale(1) rotate(0);
    }
  }
  @media not (hover: hover) {
    .card-go {
      transform: none;
    }
  }
</style>
