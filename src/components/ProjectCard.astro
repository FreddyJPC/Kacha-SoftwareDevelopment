---
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { twoDigits, type Project } from '../lib/projects';
import ProjectCover from './ProjectCover.astro';
import Arrow from './Arrow.astro';

interface Props {
  project: Project;
  index: number;
  eager?: boolean;
}
const { project, index, eager } = Astro.props;
const { title, summary, stack, year, category, client } = project.data;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<a href={localePath(lang, 'projects', project.slug)} class="card group block" data-cursor={t.common.view}>
  <div class="card-media relative overflow-hidden rounded-[calc(var(--radius-panel)*0.7)] bg-surface aspect-[4/3]">
    <ProjectCover project={project} eager={eager} />
    <span class="absolute top-4 left-4 tag !border-transparent bg-black/70 text-paper backdrop-blur-md">{category}</span>
  </div>
  <div class="mt-5 flex items-start justify-between gap-6">
    <div>
      <p class="label text-muted mb-3">({twoDigits(index + 1)}) — {client} · {year}</p>
      <h3 class="text-2xl lg:text-[1.9rem] font-bold tracking-[-0.035em] leading-[1.05]">{title}</h3>
      <p class="mt-2 text-muted max-w-md leading-snug">{summary}</p>
    </div>
    <span class="card-arrow shrink-0 grid place-items-center w-11 h-11 rounded-full border border-line text-lg">
      <Arrow />
    </span>
  </div>
  <ul class="mt-4 flex flex-wrap gap-1.5">
    {stack.slice(0, 4).map((t) => <li class="tag text-muted">{t}</li>)}
  </ul>
</a>

<style>
  .card-media :global(.cover-media) {
    transition: transform 1.1s var(--ease-out-expo);
  }
  .card-arrow {
    transition:
      background-color 0.4s var(--ease-out-expo),
      color 0.4s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo),
      border-color 0.4s;
  }
  @media (hover: hover) {
    .card:hover .card-media :global(.cover-media) {
      transform: scale(1.045);
    }
    .card:hover .card-arrow {
      background: var(--color-accent);
      border-color: var(--color-accent);
      color: #000;
      transform: rotate(45deg);
    }
  }
</style>
