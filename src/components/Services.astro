---
import { services } from '../data/services';
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import Button from './Button.astro';
import SectionHead from './SectionHead.astro';
import ServiceRows from './ServiceRows.astro';

const lang = getLang(Astro);
const t = useTranslations(lang);
---

<section id={t.ids.services} class="theme-dark bg-bg text-fg shell py-24 lg:py-36" aria-labelledby="services-title">
  <SectionHead label={t.services.label} title={t.services.title} count={services[lang].length} id="services-title">
    {t.services.intro}
  </SectionHead>

  <div class="mt-14 lg:mt-24">
    <ServiceRows />
  </div>

  <div class="mt-12 grid grid-cols-12 gap-x-6">
    <div class="col-span-12 lg:col-start-4 lg:col-span-9 flex flex-wrap gap-3" data-reveal>
      <Button href={localePath(lang, 'services')} variant="accent">{t.services.all}</Button>
      <Button href={localePath(lang, 'contact')} variant="ghost">{t.services.quote}</Button>
    </div>
  </div>
</section>
