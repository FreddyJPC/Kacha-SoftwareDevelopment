---
/** Proceso: fases del proyecto en una línea de tiempo. */
import type { CollectionEntry } from 'astro:content';
import SectionHead from '../SectionHead.astro';
import Timeline from '../Timeline.astro';
import { getLang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props { project: CollectionEntry<'projects'> }
const { process } = Astro.props.project.data;
const t = useTranslations(getLang(Astro)).project;
---

{
  process.length > 0 && (
    <section class="theme-dark bg-bg text-fg shell py-24 lg:py-32" aria-labelledby="process-title">
      <div class="grid grid-cols-12 gap-x-6 gap-y-14">
        <div class="col-span-12 lg:col-span-4">
          <div class="lg:sticky lg:top-32">
            <SectionHead label={t.process} title={t.processTitle} id="process-title" size="md" align="left">
              {t.processIntro}
            </SectionHead>
          </div>
        </div>
        <div class="col-span-12 lg:col-span-8">
          <Timeline items={process} />
        </div>
      </div>
    </section>
  )
}
