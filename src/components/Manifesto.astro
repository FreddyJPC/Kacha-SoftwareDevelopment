---
/** Quiénes somos: frase principal con subrayado tipo marcador + cifras de la agencia en tarjetas. */
import { about } from '../data/about';
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { splitMarks } from '../lib/text';
import Button from './Button.astro';
import Stats from './Stats.astro';

const lang = getLang(Astro);
const t = useTranslations(lang).manifesto;
const parts = splitMarks(about[lang].manifesto);
---

<section class="shell pt-20 lg:pt-28 pb-16 lg:pb-24" aria-labelledby="manifesto-title">
  <div class="grid grid-cols-12 gap-x-6 gap-y-8 items-start">
    <div class="col-span-12 lg:col-span-3">
      <h2 id="manifesto-title" class="label label-star text-muted" data-reveal>{t.label}</h2>
    </div>
    <div class="col-span-12 lg:col-span-9">
      <p class="lead" data-reveal data-mark>
        {parts.map((p) => (p.mark ? <span class="mark">{p.text}</span> : p.text))}
      </p>
      <div class="mt-10" data-reveal>
        <Button href={localePath(lang, 'about')} variant="solid">{t.cta}</Button>
      </div>
    </div>
  </div>

  <div class="mt-16 lg:mt-24">
    <Stats />
  </div>
</section>
