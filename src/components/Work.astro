---
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getProjects } from '../lib/projects';
import SectionHead from './SectionHead.astro';
import ProjectCard from './ProjectCard.astro';
import Button from './Button.astro';

const lang = getLang(Astro);
const t = useTranslations(lang);
const all = await getProjects(lang);
const featured = all.filter((p) => p.data.featured);
---

<section id={t.ids.projects} class="shell pt-24 lg:pt-36 pb-20 lg:pb-28" aria-labelledby="work-title">
  <SectionHead label={t.work.label} title={t.work.title} count={all.length} id="work-title">
    {t.work.intro}
  </SectionHead>

  <div class="mt-14 lg:mt-24 grid md:grid-cols-2 gap-x-6 gap-y-14 lg:gap-y-24">
    {
      featured.map((project, i) => (
        <div class={i % 2 === 1 ? 'md:mt-24 lg:mt-36' : ''} data-reveal>
          <ProjectCard project={project} index={i} />
        </div>
      ))
    }
  </div>

  <div class="mt-16 lg:mt-24 flex justify-center" data-reveal>
    <Button href={localePath(lang, 'projects')} variant="solid">{t.work.all(all.length)}</Button>
  </div>
</section>
