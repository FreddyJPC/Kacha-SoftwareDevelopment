---
/** Proyectos destacados de la portada en una cuadrícula regular de tarjetas. */
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getProjects } from '../lib/projects';
import SectionHead from './SectionHead.astro';
import ProjectCard from './ProjectCard.astro';
import Button from './Button.astro';

const lang = getLang(Astro);
const t = useTranslations(lang);
const all = await getProjects(lang);
const featured = all.filter((p) => p.data.featured);
---

<section id={t.ids.projects} class="shell pt-20 lg:pt-28 pb-16 lg:pb-24" aria-labelledby="work-title">
  <SectionHead label={t.work.label} title={t.work.heading} id="work-title">
    {t.work.intro}
  </SectionHead>

  <div class="mt-14 lg:mt-20 grid md:grid-cols-2 gap-3" data-reveal-group>
    {featured.map((project) => <ProjectCard project={project} />)}
  </div>

  <div class="mt-12 flex justify-center" data-reveal>
    <Button href={localePath(lang, 'projects')} variant="solid">{t.work.all(all.length)}</Button>
  </div>
</section>
