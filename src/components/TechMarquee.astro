---
/** Dos cintas cruzadas en diagonal con las tecnologías: una verde y otra oscura que corre en sentido contrario. */
import { marquee } from '../data/stack';
import Star from './Star.astro';
const items = [...marquee, ...marquee];
---

<div class="tapes relative bg-bg py-[clamp(3.5rem,8vw,6rem)] overflow-hidden" aria-hidden="true">
  <div class="tape tape-back">
    <div class="track track-reverse flex w-max">
      {
        [0, 1].map(() => (
          <ul class="flex shrink-0 items-center">
            {items.map((t) => (
              <li class="flex items-center">
                <span class="px-[1em]">{t}</span>
                <Star class="w-[0.55em] h-[0.55em] text-accent" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <div class="tape tape-front">
    <div class="track flex w-max">
      {
        [0, 1].map(() => (
          <ul class="flex shrink-0 items-center">
            {items.map((t) => (
              <li class="flex items-center">
                <span class="px-[1em]">{t}</span>
                <Star class="w-[0.55em] h-[0.55em]" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<style>
  .tapes {
    --bg: #000;
  }
  .tape {
    width: 110%;
    margin-left: -5%;
    padding-block: 0.85rem;
    font-size: clamp(1.05rem, 1.8vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .tape-front {
    position: relative;
    z-index: 1;
    background: var(--color-accent);
    color: #000;
    transform: rotate(-3deg);
    box-shadow: 0 18px 40px -18px rgb(0 229 153 / 0.55);
  }
  .tape-back {
    position: absolute;
    left: 0;
    top: 50%;
    background: #0e1210;
    color: rgb(244 247 245 / 0.75);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    transform: translateY(-50%) rotate(3deg);
  }
  .track {
    animation: marquee 46s linear infinite;
  }
  .track-reverse {
    animation: marquee-reverse 52s linear infinite;
  }
</style>
