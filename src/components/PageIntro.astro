---
/**
 * Cabecera de las páginas internas: insignia (o migas de pan), título con palabra destacada y texto de apoyo,
 * sobre una trama de puntos con halos de luz. center=true la centra (listados y páginas simples).
 */
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  label: string;
  title: string;
  accent?: string;
  after?: string;
  center?: boolean;
  size?: 'xl' | 'lg';
  crumbs?: { label: string; href: string }[];
}
const { label, title, accent, after, center = false, size = 'xl', crumbs } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<section data-intro class:list={['theme-dark bg-bg text-fg shell relative pt-36 lg:pt-44 pb-14 lg:pb-20 overflow-hidden', center && 'text-center']}>
  <div class="dots absolute inset-0" aria-hidden="true"></div>
  <div class="halo halo-green -top-[45%] -left-[18%]" aria-hidden="true"></div>
  <div class="halo halo-blue -top-[30%] -right-[25%]" aria-hidden="true"></div>
  <div class:list={['relative flex flex-col', center ? 'items-center' : 'items-start']}>
    {
      crumbs ? (
        <nav aria-label="Breadcrumb" class="label text-muted mb-9 flex flex-wrap items-center gap-2" data-reveal>
          <a href={localePath(lang)} class="link">{t.nav.homeLabel}</a>
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true" class="text-accent">/</span>
              <a href={c.href} class="link">{c.label}</a>
            </>
          ))}
        </nav>
      ) : (
        <p class="label label-star text-muted mb-8" data-reveal>{label}</p>
      )
    }
    <h1 class:list={['display max-w-[18ch]', size === 'xl' ? 'display-xl' : 'display-lg']} data-split>
      {title}{accent && <span class="accent">{accent}</span>}{after}
    </h1>
    {
      Astro.slots.has('default') && (
        <div class:list={['mt-7 text-xl lg:text-2xl text-muted max-w-2xl leading-snug']} data-reveal data-delay="0.25">
          <slot />
        </div>
      )
    }
  </div>
  <div class="relative">
    <slot name="after" />
  </div>
</section>
