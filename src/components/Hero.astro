---
/**
 * Hero: texto a la izquierda y collage de proyectos a la derecha (la composición del sitio original de Kacha),
 * sobre una trama de puntos con halos verde y azul. El collage sigue suavemente al cursor (data-glow).
 */
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import Button from './Button.astro';
import Star from './Star.astro';
import shotCrm from '../assets/projects/ksinuevos-crm.png';
import shotFag from '../assets/projects/fag-motors.png';
import shotVeo from '../assets/projects/veo-store-cover.png';

const lang = getLang(Astro);
const t = useTranslations(lang);
const [l1, l2, l3] = t.hero.title;
const shots = [
  { src: shotCrm, alt: 'CRM KsiNuevos', cls: 'shot-a' },
  { src: shotVeo, alt: 'Veo Optics', cls: 'shot-b' },
  { src: shotFag, alt: 'FAG Motors', cls: 'shot-c' },
];
---

<section data-hero class="hero theme-dark relative overflow-hidden bg-bg text-fg pt-28 lg:pt-36 pb-14 lg:pb-20" aria-label={t.hero.aria}>
  <div class="dots absolute inset-0" aria-hidden="true"></div>
  <div class="halo halo-green -top-[30%] -left-[20%]" aria-hidden="true"></div>
  <div class="halo halo-blue -bottom-[40%] -right-[18%]" aria-hidden="true"></div>

  <div class="shell relative grid grid-cols-12 gap-x-6 gap-y-14 items-center lg:min-h-[calc(100svh-11rem)]">
    <!-- Texto -->
    <div class="col-span-12 lg:col-span-6 relative z-10">
      <p class="label label-star text-fg/85 mb-8" data-reveal data-delay="0.45">{t.common.availability}</p>
      <h1 class="display text-[clamp(2.75rem,12.5vw,5.5rem)] lg:text-[clamp(3.6rem,6.1vw,7rem)] leading-[0.98]">
        <span class="block" data-split data-delay="0.1">{l1}</span>
        <span class="block" data-split data-delay="0.2">{l2}</span>
        <span class="block accent text-[1.08em] leading-[0.9] pb-[0.06em]" data-split data-delay="0.3">{l3}</span>
      </h1>
      <p class="mt-7 text-lg lg:text-xl leading-snug text-fg/80 max-w-xl" data-reveal data-delay="0.5">{t.hero.text}</p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal data-delay="0.6">
        <Button href={localePath(lang, 'contact')} variant="accent">{t.common.cta}</Button>
        <Button href={site.whatsapp} variant="ghost" external>{t.hero.whatsapp}</Button>
      </div>
      <ul class="mt-10 pt-7 border-t border-line flex flex-wrap gap-x-6 gap-y-3 text-sm text-fg/75" data-reveal-group data-delay="0.7">
        {
          t.hero.proof.map((item) => (
            <li class="flex items-center gap-2">
              <Star class="w-3 h-3 text-accent" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Collage de proyectos -->
    <div class="col-span-12 lg:col-span-6 relative" data-reveal data-delay="0.35">
      <div data-glow class="collage relative mx-auto w-full max-w-[640px] aspect-[10/9]">
        {
          shots.map((s, i) => (
            <figure class:list={['shot', s.cls]}>
              <Image src={s.src} alt={s.alt} widths={[480, 760, 1100]} sizes="(min-width: 1024px) 34vw, 80vw" loading={i === 0 ? 'eager' : 'lazy'} class="w-full h-auto" />
            </figure>
          ))
        }
        <div class="chip chip-quality">
          <span class="grid place-items-center w-6 h-6 rounded-full bg-accent text-black text-xs font-bold">✓</span>
          {t.hero.quality}
        </div>
        <div class="chip chip-ai">
          <Star class="w-4 h-4 text-accent" />
          {t.hero.ai}
        </div>
        <div class="seal absolute z-20 -top-[4%] -right-[2%] w-[clamp(6.5rem,20vw,9.5rem)] hidden sm:block" aria-hidden="true">
          <svg viewBox="0 0 200 200" class="seal-ring w-full h-full">
            <defs><path id="seal-path" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path></defs>
            <text class="seal-text"><textPath href="#seal-path" textLength="484">{t.hero.seal}</textPath></text>
          </svg>
          <span class="absolute inset-[24%] grid place-items-center rounded-full bg-accent text-black">
            <Star class="w-[48%] h-[48%]" />
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Indicador de scroll (del sitio original) -->
  <div class="scroll-cue absolute left-1/2 bottom-5 -translate-x-1/2 hidden lg:block" aria-hidden="true">
    <span class="mouse"><span class="wheel"></span></span>
  </div>
</section>

<style>
  .shot {
    position: absolute;
    margin: 0;
    overflow: hidden;
    border-radius: 1.1rem;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 40px 80px -30px rgb(0 0 0 / 0.9);
    transition: transform 0.9s var(--ease-out-expo);
  }
  .shot-a {
    width: 76%;
    top: 4%;
    left: 0;
    transform: rotate(-5deg);
    z-index: 1;
  }
  .shot-b {
    width: 62%;
    top: 30%;
    right: 0;
    transform: rotate(4deg);
    z-index: 2;
  }
  .shot-c {
    width: 58%;
    bottom: 0;
    left: 12%;
    transform: rotate(-1.5deg);
    z-index: 3;
  }
  @media (hover: hover) {
    .collage:hover .shot-a {
      transform: rotate(-7deg) translate(-3%, -2%);
    }
    .collage:hover .shot-b {
      transform: rotate(6deg) translate(3%, -1%);
    }
    .collage:hover .shot-c {
      transform: rotate(0deg) translateY(3%);
    }
  }
  .chip {
    position: absolute;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.1rem 0.7rem 0.75rem;
    border-radius: 0.9rem;
    background: rgb(12 14 13 / 0.6);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    animation: float-y 6s ease-in-out infinite;
  }
  .chip-quality {
    left: -3%;
    bottom: 14%;
  }
  .chip-ai {
    right: 2%;
    bottom: -3%;
    animation-delay: -3s;
  }
  .seal-ring {
    animation: spin-slow 26s linear infinite;
  }
  .seal-text {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: currentColor;
  }
  .mouse {
    display: flex;
    justify-content: center;
    width: 24px;
    height: 38px;
    padding-top: 7px;
    border-radius: 20px;
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.55);
  }
  .wheel {
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--color-accent);
    animation: wheel 1.6s ease-in-out infinite;
  }
  @keyframes wheel {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    100% {
      transform: translateY(13px);
      opacity: 0;
    }
  }
  @media (max-width: 639px) {
    .chip {
      font-size: 0.78rem;
      padding: 0.55rem 0.85rem 0.55rem 0.6rem;
    }
    .chip-quality {
      left: 0;
    }
  }
</style>
