---
/** Preguntas frecuentes. Recibe la lista (por defecto, la general de src/data/faq.ts). */
import { faq as general } from '../data/faq';
import { getLang, localePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import Button from './Button.astro';

interface Props {
  items?: { q: string; a: string }[];
  title?: string;
  intro?: string;
  id?: string;
}
const lang = getLang(Astro);
const t = useTranslations(lang);
const { items = general[lang], title = t.faq.title, intro = t.faq.intro, id = t.ids.faq } = Astro.props;
---

<section id={id} class="theme-dark bg-bg text-fg shell py-24 lg:py-36" aria-labelledby={`${id}-title`}>
  <div class="grid grid-cols-12 gap-x-6 gap-y-12">
    <div class="col-span-12 lg:col-span-5">
      <div class="lg:sticky lg:top-28">
        <span class="label label-star text-muted mb-8" data-reveal>{t.faq.label}</span>
        <h2 id={`${id}-title`} class="display display-lg" data-split>{title}<span class="dot">.</span></h2>
        <p class="mt-6 text-lg text-muted max-w-sm leading-snug" data-reveal>{intro}</p>
        <div class="mt-8" data-reveal>
          <Button href={localePath(lang, 'contact')} variant="ghost">{t.faq.ask}</Button>
        </div>
      </div>
    </div>
    <div class="col-span-12 lg:col-span-7 flex flex-col gap-2" data-reveal-group>
      {
        items.map((item) => (
          <details class="acc group rounded-2xl bg-surface" name={id}>
            <summary class="flex items-center justify-between gap-6 px-6 lg:px-8 py-6 lg:py-7 text-lg lg:text-xl font-medium tracking-tight">
              {item.q}
              <span class="faq-icon shrink-0 grid place-items-center w-7 h-7 rounded-full bg-fg text-bg" aria-hidden="true">
                <i /><i />
              </span>
            </summary>
            <p class="px-6 lg:px-8 pb-7 text-muted leading-relaxed max-w-2xl">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-icon {
    position: relative;
    transition:
      background-color 0.4s,
      transform 0.6s var(--ease-out-expo);
  }
  .faq-icon i {
    position: absolute;
    width: 38%;
    height: 1.5px;
    background: currentColor;
  }
  .faq-icon i:last-child {
    transform: rotate(90deg);
  }
  .acc[open] .faq-icon {
    background: var(--color-accent);
    transform: rotate(45deg);
  }
</style>
